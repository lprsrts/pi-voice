  "description": "Talk to your coding agent: full-duplex GPT-Live voice for Pi on macOS, with your Pi session (its model, tools, and local environment) as the backend",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "voice",
    "realtime",
    "speech-to-speech",
    "openai",
    "macos",
    "gpt-live",
    "agent"
  ],
  "license": "MIT",
  "author": "Alper Sarıtaş",
  "homepage": "https://github.com/lprsrts/pi-voice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lprsrts/pi-voice.git"
  },
  "bugs": "https://github.com/lprsrts/pi-voice/issues",
  "type": "module",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "*.ts",
    "native/",
    "providers/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
