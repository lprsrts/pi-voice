{
  "name": "@lprsrts/pi-voice",
  "version": "0.1.4",
  "description": "Talk to your coding agent: full-duplex, echo-cancelled voice for Pi on macOS (ElevenLabs Realtime or OpenAI GPT-Live) that hands work to your Pi session",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "voice",
    "realtime",
    "speech-to-speech",
    "elevenlabs",
    "openai",
    "macos"
  ],
  "license": "MIT",
  "author": "Alper Sarıtaş",
  "homepage": "https://github.com/lprsrts/pi-voice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lprsrts/pi-voice.git"
  },
  "bugs": "https://github.com/lprsrts/pi-voice/issues",
  "type": "module",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "*.ts",
    "native/",
    "providers/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/lprsrts/pi-voice/main/assets/cover.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
